OPENAI_API_KEY=your_openrouter_or_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro-0813
PORT=8080

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Password for the seeded admin account .
# If unset, admin account seeding is skipped entirely.
ADMIN_SEED_PASSWORD=

# Grant importer (background worker that periodically pulls scholarship/grant
# listings from external URLs and inserts them as pending_review for admin
# approval — see backend/GRANT_IMPORTER.md). Off by default here; production
# should set ENABLE_GRANT_IMPORTER=true with real, verified source URLs
# (checked to return actual text on a plain HTTP fetch, not just an SPA shell).
ENABLE_GRANT_IMPORTER=false
GRANT_IMPORT_SOURCES=https://get-edu.kz/publication/stipendii-i-granty-uchimsya-za-graniczej-iz-kazahstana/,https://bolashak.gov.kz/ru/o-stipendii,https://globalstudents.kz/ru/turkiyeburslari/,https://studyinkazakhstan.edu.kz/ru/edu/scholarship

# Optional — set to a Slack/Discord incoming webhook URL to get pinged on panics/critical errors. Leave empty to disable.
ERROR_WEBHOOK_URL=
